<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapper.BookMapper">

    <!-- ===================== 多对一：图书 + 所属分类 ===================== -->

    <!-- 基础映射：图书自身字段 -->
    <resultMap id="BaseResultMap" type="Book">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="author" column="author"/>
        <result property="price" column="price"/>
        <result property="categoryId" column="category_id"/>
    </resultMap>

    <!--
        多对一关联：每本书所属的分类信息
        column="category_id" 是主查询的列，作为参数传给 selectCategoryById
    -->
    <resultMap id="BookWithCategoryResultMap" type="Book" extends="BaseResultMap">
        <association property="category"
                     column="category_id"
                     select="com.mapper.CategoryMapper.selectById"/>
    </resultMap>

    <!-- 查询所有图书（带分类信息） -->
    <select id="selectAllWithCategory" resultMap="BookWithCategoryResultMap">
        SELECT id, name, author, price, category_id FROM book ORDER BY id
    </select>

    <!--
        分步查询辅助：被 CategoryMapper.xml 的一对多 collection 调用
        根据 category_id（即分类主键 id）查出分类信息
    -->
    <select id="selectAllBooksByCategoryId" resultMap="BaseResultMap">
        SELECT id, name, author, price, category_id
        FROM book
        WHERE category_id = #{categoryId}
        ORDER BY id
    </select>

    <!-- ===================== 基础 CRUD ===================== -->

    <!-- 根据 ID 查询图书 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT id, name, author, price, category_id FROM book WHERE id = #{id}
    </select>

    <!-- 新增图书 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book (name, author, price, category_id)
        VALUES (#{name}, #{author}, #{price}, #{categoryId})
    </insert>

    <!-- 更新图书（全字段覆盖） -->
    <update id="update">
        UPDATE book
        SET name = #{name}, author = #{author}, price = #{price}, category_id = #{categoryId}
        WHERE id = #{id}
    </update>

    <!--
        动态更新图书（set 标签）
        哪个字段非 null 就拼哪个 SET 子句，set 标签自动处理末尾多余的逗号
        注意：id 是 WHERE 条件，不在 set 里出现
    -->
    <update id="dynamicUpdate">
        UPDATE book
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="author != null and author != ''">
                author = #{author},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 删除图书 -->
    <delete id="delete">
        DELETE FROM book WHERE id = #{id}
    </delete>

    <!-- ===================== 动态 SQL：多条件模糊查询 ===================== -->

    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT id, name, author, price, category_id FROM book
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="author != null and author != ''">
                AND author LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId}
            </if>
            <if test="minPrice != null">
                AND price &gt;= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
        </where>
        ORDER BY id
    </select>

    <!-- ===================== foreach：批量删除 ===================== -->

    <!--
        foreach 遍历 id 集合，拼接成：
        DELETE FROM book WHERE id IN (1, 2, 3)

        collection="ids"  对应接口方法的 @Param("ids")
        item="id"         当前元素（Integer），用 #{id} 取值
        open="(" close=")" 包裹整个列表
        separator=","     元素之间用逗号分隔
    -->
    <delete id="batchDelete">
        DELETE FROM book
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- ===================== foreach：批量插入 ===================== -->

    <!--
        foreach 遍历 book 集合，拼接成：
        INSERT INTO book (name, author, price, category_id)
        VALUES (?, ?, ?, ?), (?, ?, ?, ?), (?, ?, ?, ?)

        separator=","  每条完整 VALUES 之间用逗号分隔
        item="b"       当前元素（Book 对象），用 #{b.name} 等取值
    -->
    <insert id="batchInsert">
        INSERT INTO book (name, author, price, category_id)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.name}, #{b.author}, #{b.price}, #{b.categoryId})
        </foreach>
    </insert>

</mapper>